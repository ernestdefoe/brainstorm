{
    "name": "ernestdefoe/gauntlet",
    "description": "Gauntlet — quizzes and knowledge tests for Flarum. Single and multiple choice, true/false, typed answers and image questions; timers, pass marks and attempt limits enforced on the server; leaderboards that respect privacy; quizzes playable inside a post; rewards with FoF Badges and FoF Gamification.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "quiz",
        "quizzes",
        "trivia",
        "test",
        "gamification",
        "leaderboard"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/gauntlet",
    "support": {
        "issues": "https://github.com/ernestdefoe/gauntlet/issues",
        "source": "https://github.com/ernestdefoe/gauntlet"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Gauntlet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Gauntlet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Gauntlet",
            "category": "feature",
            "icon": {
                "name": "fas fa-graduation-cap",
                "backgroundColor": "#7c3aed",
                "color": "#fff"
            },
            "optional-dependencies": [
                "fof/badges",
                "fof/gamification",
                "ernestdefoe/onramp"
            ]
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "fof/badges": "^2.0",
        "fof/gamification": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
